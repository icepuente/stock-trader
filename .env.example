# Provider: "alpaca" (US shares, paper), "bitget" (crypto, demo), or
# "ibkr" (US shares via Interactive Brokers paper account)
PROVIDER=alpaca

# --- Alpaca PAPER trading credentials --------------------------------------
# Create a free account at https://alpaca.markets then generate keys from the
# paper-trading dashboard (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# --- Bitget DEMO trading credentials (only needed if PROVIDER=bitget) ------
# IMPORTANT: production API keys are rejected (error 40099). On bitget.com,
# switch to *Demo Trading* mode first, then create the API key from inside the
# demo environment (read + trade). The bot always sends the demo-trading flag,
# so orders only ever touch Bitget's simulated futures — never real funds.
#BITGET_API_KEY=
#BITGET_SECRET_KEY=
#BITGET_PASSPHRASE=
# Demo pairs to trade (ccxt unified symbols). Leave unset to scan every
# USDT-margined future the demo environment offers (UTA demo: BTC/USDT:USDT,
# ETH/USDT:USDT, ...; classic demo: SBTC/SUSDT:SUSDT, ...):
#BITGET_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
# Set to 1 if your Bitget account is in Unified Account mode (error 40085,
# or your API-key dialog shows "Unified account" permissions):
#BITGET_UTA=1

# --- Telegram remote control + notifications (optional) --------------------
# Create a bot with @BotFather (/newbot) and paste the token here. Trade
# notifications are pushed to your chat and the bot answers /status,
# /positions, /run, /stop, ... Send /start to the bot once to bind your chat,
# then pin the chat id here so restarts reconnect and other chats are locked
# out (the server logs the id when you bind):
#TELEGRAM_BOT_TOKEN=123456789:AA...
#TELEGRAM_CHAT_ID=

# --- IBKR (only needed if PROVIDER=ibkr) ------------------------------------
# No API keys: install IB Gateway (or TWS), log in with your PAPER account
# (username starts with DU), enable API connections in
# Configuration -> API -> Settings ("Enable ActiveX and Socket Clients",
# untick "Read-Only API"). The bot refuses to run against a live login.
#IBKR_HOST=127.0.0.1
#IBKR_PORT=4002          # IB Gateway paper; use 7497 for TWS paper
#IBKR_CLIENT_ID=17

# --- LIVE trading (IBKR only) — REAL MONEY, read the README first ----------
# Off by default. Enable it here (restart required) or in the dashboard's
# ⚙ Settings panel, which demands a typed LIVE confirmation. Telegram can
# never toggle it. Going live also needs IB Gateway on your LIVE account
# (port 4001 Gateway / 7496 TWS) and typing LIVE again at every bot start.
# Everything below only applies while live.
#LIVE_TRADING=1
#LIVE_ALLOCATION_USD=500        # per-symbol sizing (paper uses $10,000)
#LIVE_MAX_DAILY_LOSS_USD=150    # flatten + halt for the day at this drawdown
#LIVE_ORDER_CAP_USD=600         # refuse any single order above this notional
